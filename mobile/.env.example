# Copy to .env.local to override. Values prefixed EXPO_PUBLIC_ are bundled into the app,
# so never put secrets here.
#
# Leave unset in development: the app then uses the dev server's host on port 8080.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
#
# Our own map tile server (Martin gateway: tiles, fonts, sprites). Leave unset in development:
# the app then uses the dev server's host on port 3000 (see backend/geo/README.md).
# EXPO_PUBLIC_TILES_URL=http://192.168.1.20:3000
