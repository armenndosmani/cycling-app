{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh run view *)",
      "Bash(./mvnw verify)",
      "Bash(./mvnw verify *)",
      "Bash(./mvnw -B -ntp verify)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx expo lint)",
      "Bash(npm audit)",
      "Bash(npm ci)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
